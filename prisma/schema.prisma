// NamesRanker — Prisma schema
// Full data model per milestones.md §2. See product-spec.md for business rules.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PREMIUM
}

enum ClaimType {
  STANDARD
  KEYWORD
  ONE_WORD
  CUSTOM
}

enum ClaimStatus {
  CLAIMED
  PROTECTED
  PENDING_RELEASE
  RELEASED
}

enum PageStatus {
  DRAFT
  PENDING
  LIVE
  REJECTED
}

enum ContentBlockType {
  BIO
  PHOTO
  EXPERIENCE
  PROJECT
  TESTIMONIAL
  SOCIAL
  PUBLICATION
  CUSTOM
}

enum ImportConnectorType {
  RSS
  GITHUB
  YOUTUBE
}

enum ShowcaseStatus {
  PENDING
  LIVE
  REJECTED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  firstName            String?
  lastName             String?
  passwordHash         String?
  emailVerifiedAt      DateTime?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  onboardedAt          DateTime?
  onboardingStep       Int?
  profilePhotoUrl      String?
  isAdmin              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  claims         NameClaim[]
  pages          Page[]
  monitoring     NameMonitoringRule[]
  auditLogs      AuditLog[]
  agentState     AgentState?
  messages       ConversationMessage[]
  approvals      ApprovalItem[]
  workLogs       WorkLog[]
  syncedProfiles SyncedProfile[]
  publishedItems PublishedItem[]
  pitches        Pitch[]
  watchedQueries WatchedQuery[]
  rankSnapshots  RankSnapshot[]
}

// ---------------------------------------------------------------------------
// v2 — agent platform (product-plan-v2.md §2.1, milestones-v2.md §5)
// Tables below are the v2 deltas ratified in M0. v1 tables above stay until
// the M10 cutover migrates them into footprint entities.
// ---------------------------------------------------------------------------

enum PermissionLevel {
  NEVER_TOUCH
  DRAFT_ONLY
  COPY_APPROVE
  FULL_AUTO
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum SyncedProfileStatus {
  DISCOVERED
  CONNECTED
  ERRORED
  DISCONNECTED
}

enum PublishedItemStatus {
  QUEUED
  PUBLISHED
  FAILED
}

enum PitchStatus {
  MATCHED
  DRAFTED
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  IGNORED
}

/**
 * Per-user agent runtime state (one row per user, created lazily).
 */
model AgentState {
  id                 String    @id @default(cuid())
  userId             String    @unique
  /**
   * Footprint Graph: person → works → skills → profiles → queries (M2).
   */
  footprint          Json?
  /**
   * Permission envelope JSON — user-set policy the agent never overrides.
   */
  permissionEnvelope Json
  /**
   * Agent working notes / day-1 plan (opaque to the client).
   */
  notes              Json?
  resumeUrl          String?
  resumeParsedAt     DateTime?
  discoveryScanAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Chat with the per-user agent — the authenticated homepage (M1/M3).
 */
model ConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "agent" | "system"
  content   String
  toolCalls Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * Consequential agent actions awaiting one-tap user sign-off (M1+).
 */
model ApprovalItem {
  id        String         @id @default(cuid())
  userId    String
  kind      String // e.g. "publish", "pitch", "profile-change", "transform"
  title     String
  summary   String?
  payload   Json?
  status    ApprovalStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/**
 * Immutable audit trail of every agent action (the user's work feed).
 */
model WorkLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // e.g. "study.detected", "publish.sent", "track.snapshot"
  tool      String?
  status    String   @default("ok")
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * A connected/known property of the user across the web (identity web).
 */
model SyncedProfile {
  id          String              @id @default(cuid())
  userId      String
  platform    String // medium | linkedin | github | …
  tier        String // "full-api" | "limited" | "closed" (product-plan-v2.md §2.3)
  displayName String?
  url         String?
  descriptor  String?
  status      SyncedProfileStatus @default(DISCOVERED)
  /**
   * Encrypted OAuth token reference — plaintext never stored.
   */
  oauthRef    String?
  lastSyncAt  DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Every syndicated/placed copy of a user's own work.
 */
model PublishedItem {
  id           String              @id @default(cuid())
  userId       String
  /**
   * Footprint work id — plain ref until M5 migration of ImportedContent.
   */
  sourceId     String?
  platform     String
  url          String?
  canonicalUrl String?
  status       PublishedItemStatus @default(QUEUED)
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Curated, continuously maintained DB of pitchable surfaces (M6).
 */
model PitchOpportunity {
  id           String   @id @default(cuid())
  vertical     String // first vertical: "consultants-execs" (milestones-v2.md §8)
  niche        String?
  platformType String // podcast | publication | directory | conference | …
  name         String
  contactUrl   String?
  notes        String?
  acceptsGuest Boolean  @default(true)
  source       String   @default("manual")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  pitches Pitch[]

  @@index([vertical, active])
}

/**
 * One pitch run on the user's behalf (M6).
 */
model Pitch {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  status        PitchStatus @default(MATCHED)
  angle         String?
  sentAt        DateTime?
  replyAt       DateTime?
  replyStatus   String?
  notes         Json?
  createdAt     DateTime    @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity PitchOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([opportunityId])
}

/**
 * Query the user's name is being ranked for (M7).
 */
model WatchedQuery {
  id               String   @id @default(cuid())
  userId           String
  query            String
  professionTagged Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rankSnapshots RankSnapshot[]

  @@unique([userId, query])
  @@index([userId])
}

/**
 * SERP position capture for a watched query (M7).
 */
model RankSnapshot {
  id             String   @id @default(cuid())
  userId         String
  watchedQueryId String
  query          String
  position       Int?
  url            String?
  raw            Json?
  capturedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedQuery WatchedQuery @relation(fields: [watchedQueryId], references: [id], onDelete: Cascade)

  @@index([userId, query, capturedAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("homepage")
  createdAt DateTime @default(now())
}

model NameClaim {
  id          String      @id @default(cuid())
  slug        String      @unique
  wordCount   Int
  type        ClaimType
  status      ClaimStatus @default(CLAIMED)
  claimedById String
  keyword     String?
  claimedAt   DateTime    @default(now())
  graceUntil  DateTime?

  claimedBy User @relation(fields: [claimedById], references: [id], onDelete: Cascade)

  @@index([claimedById])
}

model Page {
  id                     String     @id @default(cuid())
  ownerId                String
  isHub                  Boolean    @default(false)
  path                   String     @unique
  title                  String
  metaTitle              String?
  metaDescription        String?
  descriptor             String?
  status                 PageStatus @default(DRAFT)
  seoScore               Int?
  customDomain           String?    @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  publishedAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks        ContentBlock[]
  connectors    ImportConnector[]
  showcase      ShowcaseEntry?
  searchConsole SearchConsoleLink?

  @@index([ownerId])
  @@index([status])
}

model ContentBlock {
  id        String           @id @default(cuid())
  pageId    String
  type      ContentBlockType
  payload   Json
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model ImportConnector {
  id           String              @id @default(cuid())
  pageId       String
  type         ImportConnectorType
  externalUrl  String
  autoSync     Boolean             @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())

  page     Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contents ImportedContent[]

  @@index([pageId])
}

model ImportedContent {
  id          String    @id @default(cuid())
  connectorId String
  title       String
  url         String
  content     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  connector ImportConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
}

model Keyword {
  id         String @id @default(cuid())
  profession String
  keyword    String

  @@unique([profession, keyword])
  @@index([profession])
}

model NameMonitoringRule {
  id            String    @id @default(cuid())
  userId        String
  nameToMonitor String
  lastAlertAt   DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchConsoleLink {
  id                String    @id @default(cuid())
  pageId            String    @unique
  propertyUrl       String
  oauthRefreshToken String
  lastImportAt      DateTime?
  createdAt         DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model ShowcaseEntry {
  id           String         @id @default(cuid())
  pageId       String         @unique
  domain       String
  path         String
  status       ShowcaseStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([domain, path])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  /**
   * Token purpose: MAGIC_LINK (default), EMAIL_VERIFY, PASSWORD_RESET.
   */
  purpose   String    @default("MAGIC_LINK")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([purpose])
}
