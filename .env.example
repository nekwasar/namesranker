# --- Database (local: docker compose up -d postgres) ---
DATABASE_URL="postgresql://namesranker:namesranker@localhost:5432/namesranker?schema=public"

# --- Auth ---
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Redis (Upstash) ---
REDIS_URL="https://your-upstash-redis-endpoint.upstash.io"
REDIS_TOKEN="replace-with-upstash-token"

# --- Email (Brevo) ---
BREVO_API_KEY="replace-with-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@namesranker.com"
BREVO_SENDER_NAME="NamesRanker"

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
STRIPE_PRICE_MONTHLY="price_replace"
STRIPE_PRICE_ANNUAL="price_replace"
STRIPE_PRICE_LIFETIME="price_replace"

# --- Domains ---
BASE_DOMAIN="namesranker.com"
RA_NK_DOMAIN="ra-nk.me"

# --- Object storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# --- Import connectors ---
GITHUB_TOKEN="replace-with-read-only-github-token"
YOUTUBE_API_KEY="replace-with-youtube-api-key"

# --- Google Search Console (premium) ---
GOOGLE_SEARCH_CONSOLE_CLIENT_ID="replace-with-client-id"
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET="replace-with-client-secret"

# --- External cron protection ---
CRON_JOB_SECRET="replace-with-cron-secret"

# --- Error tracking (Sentry) ---
SENTRY_DSN="replace-with-sentry-dsn"
SENTRY_AUTH_TOKEN="replace-with-sentry-auth-token"
SENTRY_ORG="o4ainnovations"
SENTRY_PROJECT="namesranker"

# --- Vercel (deploy env only) ---
VERCEL_URL=""